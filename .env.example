# Copy this file to .env.local and fill in the values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# ── Enquiry emails (https://resend.com) ─────────────────────────
# API key from Resend → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where enquiries are sent. Separate several addresses with commas.
OWNER_EMAIL=owner@example.com
# Sender address. Must use a domain you verified in Resend.
# Until then, leave it empty: Resend's test sender only delivers to your own Resend account email.
FROM_EMAIL="Dulhaniyaa Website <enquiries@dulhaniyaa.com>"

# ── Public settings (visible in the browser) ────────────────────
# WhatsApp number: country code + number, digits only (no +, spaces or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=919810000000
# Your live website address, no trailing slash. Used for SEO, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://dulhaniyaa.com

# ── AI wedding plan (facilitator server) ─────────────────────────
# Public URL of the facilitator that runs the AI. No trailing slash. Not a secret.
NEXT_PUBLIC_API_URL=https://facilitator-five.vercel.app/

# ── Budget calculator leads (https://web3forms.com) ─────────────
# Access key from Web3Forms. Leads are emailed to the address the key was created with.
# This key is public by design (Web3Forms only accepts browser requests on the free plan).
# In the Web3Forms dashboard, restrict it to your website's domain.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
