# ─────────────────────────────────────────────────────────────────
#  Dulhaniyaa website settings
#
#  Copy this file to .env.local and fill in the real values.
#  Keep ONE settings file: if an old .env also exists, delete it
#  (Next.js loads both, and .env.local silently wins).
#
#  On Vercel, add the same keys under
#  Project → Settings → Environment Variables. The live site does not
#  read this file or your .env.local.
#
#  Format: KEY=value, no spaces around "=", no trailing slash on URLs.
#  All of these end up in the browser code (see next.config.ts), so
#  never add a secret here.
# ─────────────────────────────────────────────────────────────────

# AI facilitator: budget calculator rates and AI plan, and the "Plan my wedding" chat.
# REQUIRED: without it the budget calculator can't load.
# For local development of the facilitator, use http://localhost:8787 instead.
FACILITATOR_URL=https://facilitator-five.vercel.app

# Our backend: accounts, uploads, Photogram community photos, collections, sharing.
# Optional: defaults to https://api.dulhaniyaa.in.
# Use http://localhost:4000 for a local backend (localhost, not 127.0.0.1, so the login
# cookie works with the site on http://localhost:3000), or leave the value empty
# (NEXT_PUBLIC_BACKEND_URL=) to switch all of those features off.
NEXT_PUBLIC_BACKEND_URL=https://api.dulhaniyaa.in

# Web3Forms access key (https://web3forms.com). Every form on the site emails through it:
# the contact form ("Let's talk") and the budget calculator's leads. Emails go to the
# inbox the key was created with. REQUIRED, or no form can send.
# Public by design; restrict it to your domain in the Web3Forms dashboard.
WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Live website address. Used for SEO, the sitemap, social previews and Google's business details.
# Optional: defaults to https://dulhaniyaa.com.
SITE_URL=https://dulhaniyaa.com

# WhatsApp number for every WhatsApp button: country code + number, digits only.
# Optional: defaults to 919810044015.
WHATSAPP_NUMBER=919810044015
