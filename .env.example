# ─────────────────────────────────────────────────────────────────
#  Dulhaniyaa website settings
#
#  Copy this file to .env.local and fill in the real values.
#  Keep ONE settings file: if an old .env also exists, delete it
#  (Next.js loads both, and .env.local silently wins).
#
#  On Vercel, add the same keys under
#  Project → Settings → Environment Variables. The live site does not
#  read this file or your .env.local.
# ─────────────────────────────────────────────────────────────────

# AI facilitator: budget calculator rates and AI plan, and the "Plan my wedding" chat.
# REQUIRED: without it the budget calculator can't load.
# For local development of the facilitator, use http://localhost:8787 instead.
FACILITATOR_URL=https://facilitator-five.vercel.app

# Our backend: accounts, uploads, Photogram community photos, collections, sharing.
# REQUIRED on Vercel: BACKEND_URL=https://api.dulhaniyaa.in (a production build fails without it).
# Locally, in .env.local: BACKEND_URL=http://localhost:4000 (localhost, not 127.0.0.1, so the login
# cookie works with the site on http://localhost:3000). Unset in local dev means http://localhost:4000.
# An empty value (BACKEND_URL=) switches all of those features off.
# This is the only backend setting. next.config.ts copies it into NEXT_PUBLIC_BACKEND_URL for the
# browser, so don't set NEXT_PUBLIC_BACKEND_URL yourself (an old .env.local that does still works).
BACKEND_URL=http://localhost:4000

# Email of the official Dulhaniyaa account that uploads Photogram photos. Only that account sees
# the hidden bulk upload screen (/account/upload/bulk) and a link to it on the upload page; for
# everyone else it is a 404. Compared ignoring case and spaces. Optional: empty or unset hides it.
# This only hides the screen. The backend's own PHOTOGRAM_UPLOADER_EMAIL decides whose uploads
# become Photogram photos, so set both to the same address. Visible in the browser code.
NEXT_PUBLIC_PHOTOGRAM_UPLOADER_EMAIL=dulhaniyaa@abhishek.in

# Web3Forms access key (https://web3forms.com). Every form on the site emails through it:
# the contact form ("Let's talk") and the budget calculator's leads. Emails go to the
# inbox the key was created with. REQUIRED, or no form can send.
# Public by design; restrict it to your domain in the Web3Forms dashboard.
WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Sheet copy of every form lead, through a Google Apps Script web app (app/api/leads).
# SERVER-ONLY: unlike everything else in this file, these are secrets. Never add them to
# publicSettings in next.config.ts. Optional: without them the forms still email, just no sheet row.
LEADS_SCRIPT_URL=
LEADS_SCRIPT_SECRET=

# Live website address. Used for SEO, the sitemap, social previews and Google's business details.
# Optional: defaults to https://dulhaniyaa.com.
SITE_URL=https://dulhaniyaa.com

# WhatsApp number for every WhatsApp button: country code + number, digits only.
# Optional: defaults to 919810044015.
WHATSAPP_NUMBER=919810044015
